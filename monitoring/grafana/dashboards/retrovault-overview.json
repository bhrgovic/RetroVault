        {
          "datasource": {
            "type": "prometheus",
            "uid": "retrovault-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "B"
        }
