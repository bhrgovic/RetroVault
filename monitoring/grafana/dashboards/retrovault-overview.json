  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Accounts registered",
      "description": "Total accounts created since the backend last restarted.",
      "datasource": {
        "type": "prometheus",
        "uid": "retrovault-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "retrovault-prometheus"
          },
          "editorMode": "code",
          "expr": "retrovault_users_registered_total",
          "legendFormat": "Accounts registered",
          "range": true,
          "refId": "A"
        }
      ]
    },
